# Docker Compose already supplies a local PostgreSQL DATABASE_URL.
# Override this value only when the app runs outside Compose.
DATABASE_URL=postgres://expenses:expenses@localhost:5432/expenses?sslmode=disable
APP_TIMEZONE=Europe/Moscow
HTTP_ADDR=:8080
WEB_DIR=web/dist
LOG_LEVEL=info

# External integrations are disabled until their credentials are configured.
BOT_ENABLED=false
TELEGRAM_BOT_TOKEN=
FAMILY_USER_IDS=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=
LLM_API_KEY=
LLM_TIMEOUT=30s
AGENT_MAX_LLM_CALLS=4
AGENT_MAX_TOOL_CALLS=6
AGENT_MAX_CONTEXT_BYTES=32768
AGENT_TURN_TIMEOUT=60s

# Live eval uses a separate ephemeral PostgreSQL service and does not need Telegram.
LIVE_EVAL_REPEATS=3
